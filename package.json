{
  "name": "nospoilers",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:extension": "node --test extension/tests/*.test.cjs",
    "package:extension": "node scripts/package-extension.mjs",
    "test:dna": "node --experimental-strip-types --test tests/dna-v2.test.ts",
    "test:spoilers": "node --experimental-strip-types --test tests/spoiler-free.test.ts",
    "test:recommendations": "node --experimental-strip-types --test tests/recommendation-ranking.test.ts",
    "test:recommendation-preferences": "node --experimental-strip-types --test tests/recommendation-preferences.test.ts",
    "test:uploads": "node --experimental-strip-types --test tests/movie-uploads.test.ts tests/movie-matching.test.ts",
    "test:movie-night": "node --experimental-strip-types --test tests/movie-night.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts extension/tests/*.test.cjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.6.0",
    "jszip": "^3.10.1",
    "next": "16.3.1",
    "next-auth": "4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.0.2",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.26",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
