DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nospoilers"
NEXTAUTH_URL="http://localhost:3000"
# Public canonical origin. Keep the production host even on preview builds.
SITE_URL="https://www.nospoilers.xyz"
# Optional: content value from Google Search Console's HTML verification tag.
GOOGLE_SITE_VERIFICATION=""
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
TMDB_API_KEY=""
TMDB_ACCESS_TOKEN=""
# Server-only. Enables the NoSpoilers Pro Lumi companion (GPT-4o mini).
OPENAI_API_KEY=""
# Movie uploads and Theater storage. Both values stay on the server.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional: live Spoiler Zone updates. Without these, the app uses polling.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
CRON_SECRET="replace-with-a-separate-long-random-secret"
